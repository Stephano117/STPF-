{
  "name": "@stf/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/node.ts",
    "start": "node --env-file-if-exists=../../.env dist/node.js",
    "build": "prisma generate && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "create-admin": "tsx --env-file-if-exists=../../.env scripts/create-admin.ts",
    "backup": "tsx --env-file-if-exists=../../.env scripts/backup.ts",
    "backup:verify": "tsx --env-file-if-exists=../../.env scripts/backup-verify.ts",
    "restore": "tsx --env-file-if-exists=../../.env scripts/restore.ts",
    "verify:prod": "tsx scripts/verify-prod.ts",
    "local": "prisma generate && tsx --env-file-if-exists=../../.env scripts/local.ts",
    "dev:services": "tsx --env-file-if-exists=../../.env scripts/dev-services.ts",
    "dev:worker": "wrangler dev",
    "deploy": "prisma generate && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.25.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.162.0"
  }
}
