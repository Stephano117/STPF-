# SPTF — variables d'environnement.
# Copiez ce fichier en `.env` (jamais versionné). Les valeurs ci-dessous conviennent au
# développement local avec `npm run dev:services` (PostgreSQL embarqué + stockage local).
# Aucune de ces variables n'est exposée au navigateur.

NODE_ENV=development
PORT=8787

# ── Base de données PostgreSQL ────────────────────────────────────────────────
# Neon : utilisez l'URL « pooled » (hôte en -pooler) pour l'application…
DATABASE_URL=postgresql://stf:stf@localhost:5432/stf
# …et l'URL directe pour les migrations et les sauvegardes (optionnel en local).
# DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Adresse(s) publique(s) de l'application, séparées par des virgules (garde CSRF).
APP_ORIGIN=http://localhost:5173,http://localhost:8787
# true en production (HTTPS obligatoire). false uniquement en HTTP local.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Itérations PBKDF2 côté serveur (100000 sous Node ; 10000 sur Workers Free).
PASSWORD_ITERATIONS=100000
# Domaines d'e-mail acceptés à l'inscription, séparés par des virgules (vide = tous).
ALLOWED_EMAIL_DOMAINS=
# Jeton du cron de maintenance (24 caractères minimum). Générer : openssl rand -hex 32
MAINTENANCE_TOKEN=
# true si l'application est derrière un proxy de confiance (lit X-Forwarded-For).
TRUST_PROXY=false

# ── Stockage des fichiers (toute API compatible S3) ───────────────────────────
# Backblaze B2 : https://s3.<région>.backblazeb2.com   — région ex. eu-central-003
# Cloudflare R2 : https://<compte>.r2.cloudflarestorage.com — région « auto »
# Local (dev)   : http://127.0.0.1:9000                — émulateur lancé par dev:services
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=stf-files
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev-secret

# ── Limites et quotas (octets) ────────────────────────────────────────────────
# Taille maximale d'un fichier (défaut : 200 Mo).
MAX_FILE_SIZE_BYTES=209715200
# Capacité totale autorisée (défaut : 9 Go, sous les 10 Go gratuits de B2).
STORAGE_QUOTA_BYTES=9663676416
# Quota par défaut d'un espace personnel (défaut : 500 Mo).
USER_QUOTA_BYTES=524288000
# Taille maximale de la base, pour les alertes (Neon Free : 1 Go).
DATABASE_QUOTA_BYTES=1073741824
# Durée de conservation de la corbeille avant purge définitive.
TRASH_RETENTION_DAYS=30

# ── Sauvegardes (scripts npm run backup / restore) ────────────────────────────
# Dossier de destination : disque local, disque externe ou partage réseau.
BACKUP_DIR=./backups
